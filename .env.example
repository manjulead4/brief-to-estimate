# Copy to .env (never commit .env). LLM_PROVIDER=none runs fully offline on the keyword rules.
LLM_PROVIDER=none            # anthropic | openai | gemini | none
LLM_MODEL=                   # empty = provider default
LLM_FALLBACK_MODEL=          # tried if the primary model errors or returns unusable output
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: price per 1M tokens, enables per-request cost logging
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
